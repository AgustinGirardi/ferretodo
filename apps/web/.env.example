# Base de datos (SQLite por defecto, archivo local)
DATABASE_URL="file:./dev.db"

# Secreto para firmar la sesión del admin (mínimo 32 caracteres en producción)
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# URL pública del sitio (para SEO: metadata, sitemap.xml y robots.txt)
NEXT_PUBLIC_SITE_URL="https://ferretodo.com.ar"

# Carpeta donde se guardan las imágenes subidas desde el admin.
# En local se deja vacío (usa public/uploads). En producción (Render) apuntar
# al disco persistente, ej: /var/data/uploads
UPLOADS_DIR=""

# Carpeta de las copias de seguridad automáticas de la base (diarias, se
# conservan 14). En local se deja vacío (usa prisma/backups). En producción
# apuntar al disco persistente, ej: /var/data/backups
BACKUPS_DIR=""

# Emails (Resend). Si se deja vacío, los emails se "simulan" (se registran en
# la consola) y la compra funciona igual. Para enviar de verdad:
#   1) Crear una cuenta en resend.com y generar una API key
#   2) Verificar tu dominio (o usar el remitente de prueba de Resend)
RESEND_API_KEY=""
EMAIL_FROM="FERRETODO <pedidos@tudominio.com.ar>"
# Email donde la ferretería recibe el aviso de cada pedido nuevo (opcional)
STORE_EMAIL=""
