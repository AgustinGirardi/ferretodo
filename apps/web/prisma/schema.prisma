// FERRETODO — base de datos de la tienda (SQLite, editable desde el panel admin).
// Portable a PostgreSQL: no usa enums ni listas escalares (tags/specs van como
// texto/JSON), así el mismo esquema sirve para escalar en el futuro.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

// Cuenta de cliente (compradores de la tienda, separada del admin).
model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @default("")
  passwordHash String? // null = cuenta creada con Google (sin contraseña propia)
  googleId     String?  @unique // "sub" del id_token de Google
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  iconName  String    @default("bolt")
  position  Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  sku              String   @default("")

  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?   @relation(fields: [brandId], references: [id])

  price            Int
  previousPrice    Int?
  cost             Int?
  stockQty         Int      @default(0)

  iconName         String   @default("bolt")
  imageUrl         String?  // foto principal (subida desde el admin)

  shortDescription String   @default("")
  longDescription  String   @default("")
  specsJson        String   @default("[]") // JSON: [{name,value}]
  tags             String   @default("")   // separadas por coma

  rating           Float    @default(0)
  reviewCount      Int      @default(0)

  isFeatured       Boolean  @default(false)
  isNew            Boolean  @default(false)
  salesRank        Int      @default(0)

  isActive         Boolean  @default(true)  // visible en la tienda
  deletedAt        DateTime?                // borrado seguro (se puede recuperar)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
}

// Ajustes editables de la portada (hero, textos, etc.)
model SiteSetting {
  key   String @id
  value String
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerName   String
  customerEmail  String
  customerPhone  String
  deliveryMethod String // "pickup" | "delivery"
  zone           String?
  address        String?
  paymentMethod  String // "mercadopago" | "transfer" | "cash"
  status         String      @default("PENDING") // PENDING, PREPARING, READY, DELIVERED, CANCELLED
  subtotal       Int
  shippingCost   Int         @default(0)
  discount       Int         @default(0)
  total          Int
  notes          String?
  items          OrderItem[]
  // Solo se setea cuando el pedido lo hace un cliente con sesión iniciada.
  // "Mis pedidos" se muestra por esta relación, nunca por email autoafirmado.
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

// Solicitudes del botón de arrepentimiento (Res. 424/2020, Ley 24.240).
model WithdrawalRequest {
  id          String   @id @default(cuid())
  code        String   @unique // constancia que se le da al cliente, ej. AR-2026-12345
  orderNumber String   @default("")
  name        String
  email       String
  phone       String   @default("")
  reason      String   @default("")
  status      String   @default("PENDING") // PENDING | RESOLVED
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  @@index([orderId])
}
