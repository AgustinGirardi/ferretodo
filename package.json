{
  "name": "ferretodo",
  "version": "0.0.1",
  "private": true,
  "description": "FERRETODO - Plataforma de e-commerce para ferretería y corralón",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @ferretodo/web db:generate",
    "db:migrate": "pnpm --filter @ferretodo/web db:migrate",
    "db:seed": "pnpm --filter @ferretodo/web db:seed",
    "db:studio": "pnpm --filter @ferretodo/web db:studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.23",
      "browserslist": ">=4.28.7",
      "nanoid": ">=3.3.18",
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
