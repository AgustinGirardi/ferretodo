{
  "name": "ferretodo",
  "version": "0.0.1",
  "private": true,
  "description": "FERRETODO - Plataforma de e-commerce para ferretería y corralón",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @ferretodo/db generate",
    "db:migrate": "pnpm --filter @ferretodo/db migrate",
    "db:seed": "pnpm --filter @ferretodo/db seed",
    "db:studio": "pnpm --filter @ferretodo/db studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
